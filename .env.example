# Backend
PORT=4000
AUTH_SECRET=replace-with-a-long-random-string
DB_PATH=./server/data/meridian.db
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite). Leave empty for local dev so Vite proxies /api to :4000.
# In production set this to the API URL, including /api:
# VITE_API_URL=https://your-api.up.railway.app/api
VITE_API_URL=
